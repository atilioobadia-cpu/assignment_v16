[
  {
    "doctype": "Print Format",
    "name": "Payments Receipts",
    "doc_type": "Payment Entry",
    "module": "Accounts",
    "print_format_type": "Jinja",
    "html": "<!--\n\\nAATL - Payment Entry Custom Print Format (Jinja2)\n\\nSame house style as the AATL Tax Invoice / Quotation formats: Courier\n\\nNew, black-only, dotted grid, spaced-out signature block.\n\\n\n\\nInstall: Setup > Printing > Print Format > New\n\\n  Doc Type: Payment Entry\n\\n  Print Format Type: Jinja\n\\n  Paste this whole file into the \"Print Format Builder\" (HTML) field\n\\n-->\n\\n\n\\n{%- macro add_header(page_num, max_pages, doc, letter_head, no_letterhead, footer, print_settings=None, print_heading_template=None) -%}\n\\n    {% if letter_head and not no_letterhead %}\n\\n        <div class=\"letter-head-container\" style=\"margin-bottom: 8px;\">{{ letter_head }}</div>\n\\n    {% endif %}\n\\n{%- endmacro -%}\n\\n\n\\n<style>\n\\n  /* ===== Base ===== */\n\\n  .aatl-payment, .aatl-payment * {\n\\n    font-family: 'Courier New', Courier, monospace;\n\\n    color: #000 !important;\n\\n    font-size: 11.5px;\n\\n    line-height: 1.4;\n\\n    box-sizing: border-box;\n\\n  }\n\\n  .aatl-payment {\n\\n    max-width: 760px;\n\\n    margin: 0 auto;\n\\n  }\n\\n\n\\n  /* ===== Header ===== */\n\\n  .aatl-payment .header {\n\\n    text-align: center;\n\\n    margin-bottom: 6px;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding-bottom: 5px;\n\\n  }\n\\n  .aatl-payment .header .company-name {\n\\n    font-size: 16px;\n\\n    font-weight: bold;\n\\n    letter-spacing: 1px;\n\\n    text-transform: uppercase;\n\\n  }\n\\n  .aatl-payment .header .company-sub {\n\\n    font-size: 11.5px;\n\\n    margin-top: 1px;\n\\n  }\n\\n  .aatl-payment .header .doc-title {\n\\n    font-size: 13px;\n\\n    font-weight: bold;\n\\n    letter-spacing: 2px;\n\\n    margin-top: 5px;\n\\n    text-transform: uppercase;\n\\n  }\n\\n\n\\n  .aatl-payment .status-badge {\n\\n    text-align: center;\n\\n    font-weight: bold;\n\\n    letter-spacing: 2px;\n\\n    margin: 5px 0;\n\\n    border: 1px dotted #000;\n\\n    padding: 4px;\n\\n  }\n\\n\n\\n  /* ===== Meta grid: 2 columns, LABEL | VALUE rows ===== */\n\\n  .aatl-payment .meta-grid {\n\\n    display: table;\n\\n    width: 100%;\n\\n    table-layout: fixed;\n\\n    margin-top: 6px;\n\\n    margin-bottom: 6px;\n\\n    border-top: 1px dotted #000;\n\\n    border-bottom: 1px dotted #000;\n\\n  }\n\\n  .aatl-payment .meta-col {\n\\n    display: table-cell;\n\\n    width: 50%;\n\\n    vertical-align: top;\n\\n    padding: 4px 8px;\n\\n  }\n\\n  .aatl-payment .meta-col + .meta-col {\n\\n    border-left: 1px dotted #000;\n\\n  }\n\\n  .aatl-payment .meta-col-heading {\n\\n    font-weight: bold;\n\\n    text-transform: uppercase;\n\\n    letter-spacing: 0.5px;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding-bottom: 3px;\n\\n    margin-bottom: 3px;\n\\n  }\n\\n  .aatl-payment .meta-row {\n\\n    display: table;\n\\n    width: 100%;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding: 2px 0;\n\\n  }\n\\n  .aatl-payment .meta-row:last-child {\n\\n    border-bottom: none;\n\\n  }\n\\n  .aatl-payment .meta-label {\n\\n    display: table-cell;\n\\n    font-weight: bold;\n\\n    width: 54%;\n\\n  }\n\\n  .aatl-payment .meta-sep {\n\\n    display: table-cell;\n\\n    width: 6%;\n\\n  }\n\\n  .aatl-payment .meta-value {\n\\n    display: table-cell;\n\\n    width: 40%;\n\\n  }\n\\n\n\\n  /* ===== Amounts box: real columns with vertical dotted dividers ===== */\n\\n  .aatl-payment .amounts-box {\n\\n    border: 1px dotted #000;\n\\n    margin-top: 6px;\n\\n  }\n\\n  .aatl-payment .amounts-box table {\n\\n    width: 100%;\n\\n    border-collapse: collapse;\n\\n    table-layout: fixed;\n\\n  }\n\\n  .aatl-payment .amounts-box th,\n\\n  .aatl-payment .amounts-box td {\n\\n    border-right: 1px dotted #000;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding: 1px 6px;\n\\n    line-height: 1.15;\n\\n  }\n\\n  .aatl-payment .amounts-box th:last-child,\n\\n  .aatl-payment .amounts-box td:last-child {\n\\n    border-right: none;\n\\n  }\n\\n  .aatl-payment .amounts-box th {\n\\n    text-align: left;\n\\n    font-weight: bold;\n\\n    letter-spacing: 0.5px;\n\\n    text-transform: uppercase;\n\\n  }\n\\n  .aatl-payment .amounts-box th.text-right,\n\\n  .aatl-payment .amounts-box td.text-right {\n\\n    text-align: right;\n\\n  }\n\\n  .aatl-payment .amounts-box tr:last-child td {\n\\n    border-bottom: none;\n\\n  }\n\\n\n\\n  /* ===== Paid Amount highlight (same pattern as Grand Total) ===== */\n\\n  .aatl-payment .net-row {\n\\n    display: table;\n\\n    width: 100%;\n\\n    table-layout: fixed;\n\\n    border-top: 1px dotted #000;\n\\n    border-bottom: 1px dotted #000;\n\\n    font-weight: bold;\n\\n    font-size: 13px;\n\\n    padding: 6px 8px;\n\\n    margin-top: 6px;\n\\n  }\n\\n  .aatl-payment .net-row .net-label {\n\\n    display: table-cell;\n\\n    width: 60%;\n\\n  }\n\\n  .aatl-payment .net-row .net-value {\n\\n    display: table-cell;\n\\n    width: 40%;\n\\n    text-align: right;\n\\n  }\n\\n\n\\n  /* ===== Remarks ===== */\n\\n  .aatl-payment .terms-container {\n\\n    margin-top: 6px;\n\\n    padding: 6px 8px;\n\\n    border: 1px dotted #000;\n\\n  }\n\\n  .aatl-payment .terms-heading {\n\\n    font-weight: bold;\n\\n    text-transform: uppercase;\n\\n    letter-spacing: 0.5px;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding-bottom: 3px;\n\\n    margin-bottom: 3px;\n\\n  }\n\\n\n\\n  /* ===== Footer signatures ===== */\n\\n  .aatl-payment .footer {\n\\n    margin-top: 55px;\n\\n    display: table;\n\\n    width: 100%;\n\\n    table-layout: fixed;\n\\n  }\n\\n  .aatl-payment .footer .cell {\n\\n    display: table-cell;\n\\n    width: 50%;\n\\n    text-align: center;\n\\n  }\n\\n  .aatl-payment .footer .sig-line {\n\\n    margin: 10px 20px 3px 20px;\n\\n    border-bottom: 1px dotted #000;\n\\n  }\n\\n\n\\n  @media print {\n\\n    .aatl-payment * {\n\\n      -webkit-print-color-adjust: exact !important;\n\\n      print-color-adjust: exact !important;\n\\n      color-adjust: exact !important;\n\\n    }\n\\n  }\n\\n</style>\n\\n\n\\n{% for page in layout %}\n\\n<div class=\"aatl-payment\">\n\\n  {{ add_header(loop.index, layout|len, doc, letter_head, no_letterhead, footer, print_settings) }}\n\\n\n\\n  <div class=\"header\">\n\\n    <div class=\"company-name\">{{ doc.company }}</div>\n\\n    <div class=\"company-sub\">\n\\n      {% if frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\n\\n        TIN: {{ frappe.db.get_value(\"Company\", doc.company, \"tax_id\") }}\n\\n      {% endif %}\n\\n    </div>\n\\n    <div class=\"doc-title\">Payment Receipt</div>\n\\n  </div>\n\\n\n\\n  {%- if doc.docstatus==2 -%}\n\\n    <div class=\"status-badge\">{{ _(\"CANCELLED\") }}</div>\n\\n  {%- endif -%}\n\\n  {%- if doc.docstatus==0 -%}\n\\n    <div class=\"status-badge\">{{ _(\"DRAFT\") }}</div>\n\\n  {%- endif -%}\n\\n\n\\n  {#- Currency label used to prefix amounts (falls back to TZS if the\n\\n      account currency fields aren't set on this record). -#}\n\\n  {% set cur = doc.get(\"paid_to_account_currency\") or doc.get(\"paid_from_account_currency\") or doc.get(\"currency\") or \"TZS\" %}\n\\n  {% set paid_to_type = frappe.db.get_value(\"Account\", doc.paid_to, \"account_type\") if doc.paid_to else \"\" %}\n\\n\n\\n  <div class=\"meta-grid\">\n\\n    <div class=\"meta-col\">\n\\n      <div class=\"meta-col-heading\">{{ _(\"Payment Details\") }}</div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">PAYMENT ENTRY NO</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.name }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">POSTING DATE</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ frappe.utils.format_date(doc.posting_date) }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">MODE OF PAYMENT</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.mode_of_payment or \"\" }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">PARTY</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.party or \"\" }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">PARTY NAME</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.party_name or \"\" }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">CHEQUE/REFERENCE DATE</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ frappe.utils.format_date(doc.reference_date) if doc.reference_date else \"\" }}</div>\n\\n      </div>\n\\n    </div>\n\\n    <div class=\"meta-col\">\n\\n      <div class=\"meta-col-heading\">{{ _(\"Account & Status\") }}</div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">PAID TO ACC. TYPE</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ paid_to_type }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">BRANCH</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.branch or \"\" }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">PAYMENT ORDER STATUS</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.get(\"payment_order_status\") or \"\" }}</div>\n\\n      </div>\n\\n    </div>\n\\n  </div>\n\\n\n\\n  <div class=\"amounts-box\">\n\\n    <table>\n\\n      <thead>\n\\n        <tr>\n\\n          <th style=\"width:52%\">Payment Descriptions</th>\n\\n          <th class=\"text-right\" style=\"width:48%\">Amount</th>\n\\n        </tr>\n\\n      </thead>\n\\n      <tbody>\n\\n        <tr>\n\\n          <td>Paid Amount After Tax</td>\n\\n          <td class=\"text-right\">{{ cur }} {{ \"{:,.2f}\".format(doc.get(\"paid_amount_after_tax\") or doc.paid_amount or 0) }}</td>\n\\n        </tr>\n\\n        <tr>\n\\n          <td>Received Amount After Tax</td>\n\\n          <td class=\"text-right\">{{ cur }} {{ \"{:,.2f}\".format(doc.get(\"received_amount_after_tax\") or doc.get(\"received_amount\") or 0) }}</td>\n\\n        </tr>\n\\n        <tr>\n\\n          <td>Bank Charges</td>\n\\n          <td class=\"text-right\">{{ \"{:,.2f}\".format(doc.get(\"bank_charges\") or 0) }}</td>\n\\n        </tr>\n\\n        <tr>\n\\n          <td>Total Taxes and Charges</td>\n\\n          <td class=\"text-right\">{{ cur }} {{ \"{:,.2f}\".format(doc.get(\"total_taxes_and_charges\") or 0) }}</td>\n\\n        </tr>\n\\n        <tr>\n\\n          <td>Exchange Difference</td>\n\\n          <td class=\"text-right\">{{ cur }} {{ \"{:,.2f}\".format(doc.get(\"exchange_difference\") or doc.get(\"difference_amount\") or 0) }}</td>\n\\n        </tr>\n\\n      </tbody>\n\\n    </table>\n\\n  </div>\n\\n\n\\n  <div class=\"net-row\">\n\\n    <div class=\"net-label\">PAID AMOUNT ({{ cur }})</div>\n\\n    <div class=\"net-value\">{{ cur }} {{ \"{:,.2f}\".format(doc.paid_amount or 0) }}</div>\n\\n  </div>\n\\n\n\\n  {% if doc.remarks %}\n\\n  <div class=\"terms-container\">\n\\n    <div class=\"terms-heading\">{{ _(\"Narration\") }}</div>\n\\n    <div>{{ doc.remarks }}</div>\n\\n  </div>\n\\n  {% endif %}\n\\n\n\\n  <div class=\"footer\">\n\\n    <div class=\"cell\">\n\\n      <div class=\"sig-line\"></div>\n\\n      Prepared By\n\\n    </div>\n\\n    <div class=\"cell\">\n\\n      <div class=\"sig-line\"></div>\n\\n      Received By\n\\n    </div>\n\\n  </div>\n\\n\n\\n  {% if not no_letterhead and footer %}\n\\n    <div class=\"print-footer\" style=\"margin-top: 12px;\">\n\\n      {{ footer }}\n\\n    </div>\n\\n  {% endif %}\n\\n</div>\n\\n{% endfor %}",
    "disabled": 0,
    "default_print_language": "en",
    "standard": "No"
  }
]