  "html": "<style>\n\t@page {\n\t\tsize: A4 portrait;\n\t\tmargin: 12mm;\n\t}\n\tbody,\n\thtml {\n\t\tmargin: 0;\n\t\tpadding: 0;\n\t}\n\t* {\n\t\tbox-sizing: border-box;\n\t}\n\t.certificate {\n\t\tborder: 5px double #1a7a3c;\n\t\toutline: 1px solid #1a7a3c;\n\t\toutline-offset: -8px;\n\t\tpadding: 36px 44px 32px 44px;\n\t\tfont-family: Georgia, \"Times New Roman\", serif;\n\t\tcolor: #222;\n\t}\n\t.firm {\n\t\ttext-align: center;\n\t\tmargin-bottom: 6px;\n\t}\n\t.firm .firm-name {\n\t\tfont-size: 22px;\n\t\tfont-weight: bold;\n\t\tletter-spacing: 2px;\n\t\tcolor: #1a7a3c;\n\t\tmargin: 0;\n\t}\n\t.firm .firm-tag {\n\t\tfont-size: 12px;\n\t\tletter-spacing: 3px;\n\t\tcolor: #555;\n\t\tmargin: 2px 0 0 0;\n\t\ttext-transform: uppercase;\n\t}\n\t.rule {\n\t\tborder: none;\n\t\tborder-top: 1px solid #1a7a3c;\n\t\tmargin: 14px 0 20px 0;\n\t}\n\t.title {\n\t\ttext-align: center;\n\t\tfont-size: 28px;\n\t\tletter-spacing: 5px;\n\t\tcolor: #1a7a3c;\n\t\tfont-weight: bold;\n\t\tmargin: 0 0 8px 0;\n\t}\n\t.subtitle {\n\t\ttext-align: center;\n\t\tfont-size: 14px;\n\t\tfont-style: italic;\n\t\tletter-spacing: 1px;\n\t\tcolor: #444;\n\t\tmargin: 0 0 26px 0;\n\t}\n\t.intro {\n\t\ttext-align: center;\n\t\tfont-size: 14px;\n\t\tline-height: 1.9;\n\t\tmargin-bottom: 10px;\n\t}\n\t.client {\n\t\tfont-size: 24px;\n\t\tfont-weight: bold;\n\t\tcolor: #111;\n\t\ttext-align: center;\n\t\tmargin: 6px 0;\n\t\tletter-spacing: 1px;\n\t}\n\t.project-name {\n\t\tfont-size: 16px;\n\t\tfont-weight: bold;\n\t\ttext-align: center;\n\t\tcolor: #333;\n\t\tmargin: 0 0 14px 0;\n\t}\n\t.body-text {\n\t\ttext-align: center;\n\t\tfont-size: 14px;\n\t\tline-height: 1.9;\n\t}\n\t.aatl {\n\t\tmargin-top: 14px;\n\t\ttext-align: center;\n\t\tfont-size: 13px;\n\t\tfont-style: italic;\n\t\tcolor: #555;\n\t}\n\t.signature-row {\n\t\tdisplay: flex;\n\t\tmargin-top: 46px;\n\t\ttext-align: center;\n\t}\n\t.signature-col {\n\t\tflex: 1;\n\t}\n\t.signature-line {\n\t\tborder-top: 1px solid #333;\n\t\tpadding-top: 6px;\n\t\tfont-size: 12px;\n\t\tfont-weight: bold;\n\t}\n\t.signature-label {\n\t\tfont-size: 11px;\n\t\tfont-style: italic;\n\t\tcolor: #555;\n\t}\n\t.date-line {\n\t\ttext-align: center;\n\t\tfont-size: 13px;\n\t\tmargin-top: 18px;\n\t\tcolor: #222;\n\t}\n</style>\n\n<div class=\"certificate\">\n\t<div class=\"firm\">\n\t\t<p class=\"firm-name\">ALPHA ASSOCIATES (T) LIMITED</p>\n\t\t<p class=\"firm-tag\">Certified Public Accountants &amp; Business Advisors</p>\n\t\t<p class=\"firm-tag\">Tanzania</p>\n\t</div>\n\t<hr class=\"rule\" />\n\n\t<h1 class=\"title\">CERTIFICATE OF COMPLETION</h1>\n\t<p class=\"subtitle\">This is proudly presented to</p>\n\t<p class=\"client\">{% set client = frappe.db.get_value(\"Customer\", doc.customer, \"customer_name\") or doc.customer %}{{ client }}</p>\n\t<p class=\"project-name\">\n\t\t{% set pname = frappe.db.get_value(\"Project\", doc.project, \"project_name\") or doc.project %}\n\t\tProject: <b>{{ pname }}</b>\n\t</p>\n\n\t<p class=\"body-text\">\n\t\tWe are delighted to certify that the above project assigned to\n\t\t<b>{{ client }}</b> has been <b>successfully completed</b>, and all\n\t\tagreed deliverables have been accomplished.\n\t</p>\n\t<p class=\"body-text\">\n\t\tThis certificate is issued in recognition of a job well done, and we\n\t\tthank you for trusting our firm with this engagement.\n\t</p>\n\t<p class=\"aatl\">\n\t\tThis project was executed with the professional assistance of our firm,\n\t\t<b>Alpha Associates (T) Limited (AATL)</b>.\n\t</p>\n\n\t<div class=\"signature-row\">\n\t\t<div class=\"signature-col\">\n\t\t\t<div class=\"signature-line\">{{ doc.prepared_by or \"________________\" }}</div>\n\t\t\t<div class=\"signature-label\">Prepared By</div>\n\t\t</div>\n\t\t<div class=\"signature-col\">\n\t\t\t<div class=\"signature-line\">{{ doc.reviewed_by or \"________________\" }}</div>\n\t\t\t<div class=\"signature-label\">Reviewed By</div>\n\t\t</div>\n\t\t<div class=\"signature-col\">\n\t\t\t<div class=\"signature-line\">{{ doc.approved_by or \"________________\" }}</div>\n\t\t\t<div class=\"signature-label\">Approved By</div>\n\t\t</div>\n\t</div>\n\n\t<div class=\"date-line\">{{ doc.approval_date or doc.closure_date }}</div>\n</div>",
