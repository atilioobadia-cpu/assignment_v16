[
  {
    "doctype": "Print Format",
    "name": "Quotation",
    "doc_type": "Sales Order",
    "module": "Accounts",
    "print_format_type": "Jinja",
    "html": "<!--\n\\nAATL - Sales Order Custom Print Format (Jinja2)\n\\nTitled \"Quotation\" on the printed document. Same house style as the\n\\nAATL Tax Invoice format: Courier New, black-only, dotted grid, VAT %\n\\ndetection, single-line bank details, spaced-out signature block.\n\\n\n\\nInstall: Setup > Printing > Print Format > New\n\\n  Doc Type: Sales Order\n\\n  Print Format Type: Jinja\n\\n  Paste this whole file into the \"Print Format Builder\" (HTML) field\n\\n-->\n\\n\n\\n{%- macro add_header(page_num, max_pages, doc, letter_head, no_letterhead, footer, print_settings=None, print_heading_template=None) -%}\n\\n    {% if letter_head and not no_letterhead %}\n\\n        <div class=\"letter-head-container\" style=\"margin-bottom: 8px;\">{{ letter_head }}</div>\n\\n    {% endif %}\n\\n{%- endmacro -%}\n\\n\n\\n<style>\n\\n  /* ===== Base ===== */\n\\n  .aatl-quotation, .aatl-quotation * {\n\\n    font-family: 'Courier New', Courier, monospace;\n\\n    color: #000 !important;\n\\n    font-size: 11.5px;\n\\n    line-height: 1.4;\n\\n    box-sizing: border-box;\n\\n  }\n\\n  .aatl-quotation {\n\\n    max-width: 760px;\n\\n    margin: 0 auto;\n\\n  }\n\\n\n\\n  /* ===== Header ===== */\n\\n  .aatl-quotation .header {\n\\n    text-align: center;\n\\n    margin-bottom: 6px;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding-bottom: 5px;\n\\n  }\n\\n  .aatl-quotation .header .company-name {\n\\n    font-size: 16px;\n\\n    font-weight: bold;\n\\n    letter-spacing: 1px;\n\\n    text-transform: uppercase;\n\\n  }\n\\n  .aatl-quotation .header .company-sub {\n\\n    font-size: 11.5px;\n\\n    margin-top: 1px;\n\\n  }\n\\n  .aatl-quotation .header .doc-title {\n\\n    font-size: 13px;\n\\n    font-weight: bold;\n\\n    letter-spacing: 2px;\n\\n    margin-top: 5px;\n\\n    text-transform: uppercase;\n\\n  }\n\\n\n\\n  .aatl-quotation .status-badge {\n\\n    text-align: center;\n\\n    font-weight: bold;\n\\n    letter-spacing: 2px;\n\\n    margin: 5px 0;\n\\n    border: 1px dotted #000;\n\\n    padding: 4px;\n\\n  }\n\\n\n\\n  /* ===== Meta grid (Bill To / Order info) ===== */\n\\n  .aatl-quotation .meta-grid {\n\\n    display: table;\n\\n    width: 100%;\n\\n    table-layout: fixed;\n\\n    margin-bottom: 6px;\n\\n    border-top: 1px dotted #000;\n\\n    border-bottom: 1px dotted #000;\n\\n  }\n\\n  .aatl-quotation .meta-col {\n\\n    display: table-cell;\n\\n    width: 50%;\n\\n    vertical-align: top;\n\\n    padding: 4px 8px;\n\\n  }\n\\n  .aatl-quotation .meta-col + .meta-col {\n\\n    border-left: 1px dotted #000;\n\\n  }\n\\n  .aatl-quotation .meta-col-heading {\n\\n    font-weight: bold;\n\\n    text-transform: uppercase;\n\\n    letter-spacing: 0.5px;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding-bottom: 3px;\n\\n    margin-bottom: 3px;\n\\n  }\n\\n  .aatl-quotation .customer-body {\n\\n    padding-bottom: 2px;\n\\n  }\n\\n  .aatl-quotation .meta-row {\n\\n    display: table;\n\\n    width: 100%;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding: 2px 0;\n\\n  }\n\\n  .aatl-quotation .meta-row:last-child {\n\\n    border-bottom: none;\n\\n  }\n\\n  .aatl-quotation .meta-label {\n\\n    display: table-cell;\n\\n    font-weight: bold;\n\\n    width: 46%;\n\\n  }\n\\n  .aatl-quotation .meta-sep {\n\\n    display: table-cell;\n\\n    width: 6%;\n\\n  }\n\\n  .aatl-quotation .meta-value {\n\\n    display: table-cell;\n\\n    width: 48%;\n\\n  }\n\\n\n\\n  /* ===== Items table: real columns with vertical dotted dividers ===== */\n\\n  .aatl-quotation .items-box {\n\\n    border: 1px dotted #000;\n\\n    margin-top: 6px;\n\\n  }\n\\n  .aatl-quotation .items-box table {\n\\n    width: 100%;\n\\n    border-collapse: collapse;\n\\n    table-layout: fixed;\n\\n  }\n\\n  .aatl-quotation .items-box th,\n\\n  .aatl-quotation .items-box td {\n\\n    border-right: 1px dotted #000;\n\\n    border-bottom: 1px dotted #000;\n\\n  }\n\\n  .aatl-quotation .items-box th:last-child,\n\\n  .aatl-quotation .items-box td:last-child {\n\\n    border-right: none;\n\\n  }\n\\n  .aatl-quotation .items-box th {\n\\n    text-align: left;\n\\n    padding: 5px 6px;\n\\n    font-weight: bold;\n\\n    letter-spacing: 0.5px;\n\\n    text-transform: uppercase;\n\\n  }\n\\n  .aatl-quotation .items-box th.text-right,\n\\n  .aatl-quotation .items-box td.text-right {\n\\n    text-align: right;\n\\n  }\n\\n  .aatl-quotation .items-box th.text-center,\n\\n  .aatl-quotation .items-box td.text-center {\n\\n    text-align: center;\n\\n  }\n\\n  .aatl-quotation .items-box td {\n\\n    padding: 4px 6px;\n\\n    vertical-align: top;\n\\n  }\n\\n  .aatl-quotation .items-box tbody tr:last-child td {\n\\n    border-bottom: none;\n\\n  }\n\\n  .aatl-quotation .item-description {\n\\n    font-size: 10px;\n\\n    margin-top: 1px;\n\\n  }\n\\n\n\\n  /* ===== Words + totals row, same height, aligned ===== */\n\\n  .aatl-quotation .summary-grid {\n\\n    display: table;\n\\n    width: 100%;\n\\n    table-layout: fixed;\n\\n    margin-top: 6px;\n\\n    border: 1px dotted #000;\n\\n    border-collapse: collapse;\n\\n  }\n\\n  .aatl-quotation .words-col {\n\\n    display: table-cell;\n\\n    width: 55%;\n\\n    vertical-align: top;\n\\n    padding: 6px 8px;\n\\n    border-right: 1px dotted #000;\n\\n  }\n\\n  .aatl-quotation .words-caption {\n\\n    font-weight: bold;\n\\n    text-transform: uppercase;\n\\n    letter-spacing: 0.5px;\n\\n  }\n\\n  .aatl-quotation .words-value {\n\\n    margin-top: 3px;\n\\n  }\n\\n  .aatl-quotation .totals-col {\n\\n    display: table-cell;\n\\n    width: 45%;\n\\n    vertical-align: top;\n\\n    padding: 0;\n\\n  }\n\\n  .aatl-quotation .totals-col table {\n\\n    width: 100%;\n\\n    border-collapse: collapse;\n\\n    table-layout: fixed;\n\\n  }\n\\n  .aatl-quotation .totals-col td {\n\\n    padding: 4px 8px;\n\\n    border-bottom: 1px dotted #000;\n\\n  }\n\\n  .aatl-quotation .totals-col td.text-right {\n\\n    text-align: right;\n\\n  }\n\\n  .aatl-quotation .totals-col tr:last-child td {\n\\n    border-bottom: none;\n\\n  }\n\\n\n\\n  /* ===== Grand Total ===== */\n\\n  .aatl-quotation .net-row {\n\\n    display: table;\n\\n    width: 100%;\n\\n    table-layout: fixed;\n\\n    border-top: 1px dotted #000;\n\\n    border-bottom: 1px dotted #000;\n\\n    font-weight: bold;\n\\n    font-size: 13px;\n\\n    padding: 6px 8px;\n\\n    margin-top: 6px;\n\\n  }\n\\n  .aatl-quotation .net-row .net-label {\n\\n    display: table-cell;\n\\n    width: 60%;\n\\n  }\n\\n  .aatl-quotation .net-row .net-value {\n\\n    display: table-cell;\n\\n    width: 40%;\n\\n    text-align: right;\n\\n  }\n\\n\n\\n  /* ===== Terms ===== */\n\\n  .aatl-quotation .terms-container {\n\\n    margin-top: 6px;\n\\n    padding: 6px 8px;\n\\n    border: 1px dotted #000;\n\\n  }\n\\n  .aatl-quotation .terms-heading {\n\\n    font-weight: bold;\n\\n    text-transform: uppercase;\n\\n    letter-spacing: 0.5px;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding-bottom: 3px;\n\\n    margin-bottom: 3px;\n\\n  }\n\\n\n\\n  /* ===== Bank details block ===== */\n\\n  .aatl-quotation .bank-details {\n\\n    margin-top: 10px;\n\\n    padding-top: 6px;\n\\n    border-top: 1px dotted #000;\n\\n    font-weight: bold;\n\\n    text-align: center;\n\\n  }\n\\n\n\\n  /* ===== Footer signatures ===== */\n\\n  .aatl-quotation .footer {\n\\n    margin-top: 55px;\n\\n    display: table;\n\\n    width: 100%;\n\\n    table-layout: fixed;\n\\n  }\n\\n  .aatl-quotation .footer .cell {\n\\n    display: table-cell;\n\\n    width: 50%;\n\\n    text-align: center;\n\\n  }\n\\n  .aatl-quotation .footer .sig-line {\n\\n    margin: 10px 20px 3px 20px;\n\\n    border-bottom: 1px dotted #000;\n\\n  }\n\\n  .aatl-quotation .note {\n\\n    margin-top: 6px;\n\\n    font-size: 10px;\n\\n    text-align: center;\n\\n    font-style: italic;\n\\n  }\n\\n\n\\n  @media print {\n\\n    .aatl-quotation * {\n\\n      -webkit-print-color-adjust: exact !important;\n\\n      print-color-adjust: exact !important;\n\\n      color-adjust: exact !important;\n\\n    }\n\\n  }\n\\n</style>\n\\n\n\\n{% for page in layout %}\n\\n<div class=\"aatl-quotation\">\n\\n  {{ add_header(loop.index, layout|len, doc, letter_head, no_letterhead, footer, print_settings) }}\n\\n\n\\n  <div class=\"header\">\n\\n    <div class=\"company-name\">{{ doc.company }}</div>\n\\n    <div class=\"company-sub\">\n\\n      {% if frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\n\\n        TIN: {{ frappe.db.get_value(\"Company\", doc.company, \"tax_id\") }}\n\\n      {% endif %}\n\\n    </div>\n\\n    <div class=\"doc-title\">Quotation</div>\n\\n  </div>\n\\n\n\\n  {%- if doc.meta.is_submittable and doc.docstatus==2 -%}\n\\n    <div class=\"status-badge\">{{ _(\"CANCELLED\") }}</div>\n\\n  {%- endif -%}\n\\n  {%- if doc.meta.is_submittable and doc.docstatus==0 and (print_settings==None or print_settings.add_draft_heading) -%}\n\\n    <div class=\"status-badge\">{{ _(\"DRAFT\") }}</div>\n\\n  {%- endif -%}\n\\n\n\\n  <div class=\"meta-grid\">\n\\n    <div class=\"meta-col\">\n\\n      <div class=\"meta-col-heading\">{{ _(\"Bill To\") }}</div>\n\\n      <div class=\"customer-body\">\n\\n        <strong>{{ doc.customer_name }}</strong><br>\n\\n        {% if doc.customer_address %}\n\\n          {% set addr = frappe.db.get_value(\"Address\", doc.customer_address, [\"address_line1\", \"address_line2\", \"city\", \"state\", \"pincode\", \"country\"], as_dict=True) %}\n\\n          {{ addr.address_line1 or \"\" }}<br>\n\\n          {% if addr.address_line2 %}{{ addr.address_line2 }}<br>{% endif %}\n\\n          {{ addr.city or \"\" }}{% if addr.state %}, {{ addr.state }}{% endif %} {{ addr.pincode or \"\" }}<br>\n\\n          {{ addr.country or \"\" }}\n\\n        {% endif %}\n\\n      </div>\n\\n    </div>\n\\n    <div class=\"meta-col\">\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">ORDER NO</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.name }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">ORDER DATE</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ frappe.utils.format_date(doc.transaction_date) }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">DELIVERY DATE</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ frappe.utils.format_date(doc.delivery_date) }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">CURRENCY</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.currency }}</div>\n\\n      </div>\n\\n    </div>\n\\n  </div>\n\\n\n\\n  {#- ===== VAT detection =====\n\\n      1. Look through doc.taxes for a row whose description mentions \"VAT\".\n\\n      2. If found, that's ns.vat_tax and ns.has_vat = true.\n\\n      3. Build a per-item VAT map from that row's item_wise_tax_detail\n\\n         (ERPNext JSON: {item_code: [rate, amount]}).\n\\n      4. If an item is missing from that map (can happen with older data),\n\\n         fall back to the tax row's overall rate.\n\\n      5. If the order has NO vat tax row at all, every item shows \"-\"\n\\n         instead of a fabricated rate, so it's clear no VAT applies. -#}\n\\n  {% set ns = namespace(vat_tax=None) %}\n\\n  {% for tax in doc.taxes %}\n\\n    {% if not ns.vat_tax and \"vat\" in (tax.description or \"\").lower() %}\n\\n      {% set ns.vat_tax = tax %}\n\\n    {% endif %}\n\\n  {% endfor %}\n\\n  {% set has_vat = ns.vat_tax is not none %}\n\\n  {% set vat_map = frappe.parse_json(ns.vat_tax.item_wise_tax_detail) if (has_vat and ns.vat_tax.item_wise_tax_detail) else {} %}\n\\n\n\\n  <div class=\"items-box\">\n\\n    <table>\n\\n      <thead>\n\\n        <tr>\n\\n          <th class=\"text-center\" style=\"width:5%\">#</th>\n\\n          <th style=\"width:44%\">Item</th>\n\\n          <th class=\"text-right\" style=\"width:8%\">Qty</th>\n\\n          <th class=\"text-right\" style=\"width:15%\">Rate</th>\n\\n          <th class=\"text-right\" style=\"width:9%\">VAT</th>\n\\n          <th class=\"text-right\" style=\"width:19%\">Total</th>\n\\n        </tr>\n\\n      </thead>\n\\n      <tbody>\n\\n        {% for item in doc.items %}\n\\n        {% set vat_row = vat_map.get(item.item_code) %}\n\\n        <tr>\n\\n          <td class=\"text-center\">{{ loop.index }}</td>\n\\n          <td>\n\\n            <strong>{{ item.item_name }}</strong>\n\\n            {% if item.description and item.description != item.item_name %}\n\\n              <div class=\"item-description\">{{ item.description }}</div>\n\\n            {% endif %}\n\\n          </td>\n\\n          <td class=\"text-right\">{{ item.qty }}</td>\n\\n          <td class=\"text-right\">{{ \"{:,.2f}\".format(item.net_rate) }}</td>\n\\n          <td class=\"text-right\">\n\\n            {% if not has_vat %}\n\\n              -\n\\n            {% elif vat_row %}\n\\n              {{ \"{:g}\".format(vat_row[0]) }}%\n\\n            {% else %}\n\\n              {{ \"{:g}\".format(ns.vat_tax.rate) }}%\n\\n            {% endif %}\n\\n          </td>\n\\n          <td class=\"text-right\">{{ \"{:,.2f}\".format(item.net_amount) }}</td>\n\\n        </tr>\n\\n        {% endfor %}\n\\n      </tbody>\n\\n    </table>\n\\n  </div>\n\\n\n\\n  <div class=\"summary-grid\">\n\\n    <div class=\"words-col\">\n\\n      <div class=\"words-caption\">{{ _(\"Total In Words\") }}</div>\n\\n      <div class=\"words-value\">{{ doc.in_words }}</div>\n\\n    </div>\n\\n    <div class=\"totals-col\">\n\\n      <table>\n\\n        <tr>\n\\n          <td>NET TOTAL</td>\n\\n          <td class=\"text-right\">{{ doc.get_formatted(\"total\", doc) }}</td>\n\\n        </tr>\n\\n        {%- if doc.discount_amount -%}\n\\n        <tr>\n\\n          <td>DISCOUNT</td>\n\\n          <td class=\"text-right\">{{ doc.get_formatted(\"discount_amount\", doc) }}</td>\n\\n        </tr>\n\\n        {%- endif -%}\n\\n        {%- for tax in doc.taxes -%}\n\\n          {%- if tax.tax_amount_after_discount_amount -%}\n\\n          <tr>\n\\n            <td>{{ tax.description | upper }}</td>\n\\n            <td class=\"text-right\">{{ tax.get_formatted(\"tax_amount_after_discount_amount\", doc) }}</td>\n\\n          </tr>\n\\n          {%- endif -%}\n\\n        {%- endfor -%}\n\\n      </table>\n\\n    </div>\n\\n  </div>\n\\n\n\\n  <div class=\"net-row\">\n\\n    <div class=\"net-label\">GRAND TOTAL ({{ doc.currency }})</div>\n\\n    <div class=\"net-value\">{{ doc.get_formatted(\"grand_total\", doc) }}</div>\n\\n  </div>\n\\n\n\\n  {% if doc.terms %}\n\\n  <div class=\"terms-container\">\n\\n    <div class=\"terms-heading\">{{ _(\"Terms and Conditions\") }}</div>\n\\n    <div>{{ doc.terms }}</div>\n\\n  </div>\n\\n  {% endif %}\n\\n\n\\n  <div class=\"bank-details\">\n\\n    ACCOUNT NAME: ALPHA ASSOCIATES TANZANIA LIMITED &nbsp;***&nbsp; AZANIA BANK: 002000020252 &nbsp;***&nbsp; NMB BANK: 42810012287 &nbsp;***&nbsp; CRDB BANK PLC: 015C000UF7Y00\n\\n  </div>\n\\n\n\\n  <div class=\"footer\">\n\\n    <div class=\"cell\">\n\\n      <div class=\"sig-line\"></div>\n\\n      Prepared By\n\\n    </div>\n\\n    <div class=\"cell\">\n\\n      <div class=\"sig-line\"></div>\n\\n      Authorized Signature\n\\n    </div>\n\\n  </div>\n\\n\n\\n  {% if not no_letterhead and footer %}\n\\n    <div class=\"print-footer\" style=\"margin-top: 12px;\">\n\\n      {{ footer }}\n\\n    </div>\n\\n  {% endif %}\n\\n</div>\n\\n{% endfor %}",
    "disabled": 0,
    "default_print_language": "en",
    "standard": "No"
  }
]