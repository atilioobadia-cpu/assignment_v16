[
  {
    "doctype": "Print Format",
    "name": "Salary Slip",
    "doc_type": "Salary Slip",
    "module": "Payroll",
    "print_format_type": "Jinja",
    "html": "<!--\n\\nAATL - Salary Slip Custom Print Format (Jinja2)\n\\nInstall: Setup > Printing > Print Format > New\n\\n  Doc Type: Salary Slip\n\\n  Print Format Type: Jinja\n\\n  Paste this whole file into the \"Print Format Builder\" (HTML) field\n\\n-->\n\\n\n\\n<style>\n\\n  .aatl-payslip {\n\\n    font-family: 'Courier New', Courier, monospace;\n\\n    color: #000;\n\\n    font-size: 12.5px;\n\\n    max-width: 760px;\n\\n    margin: 0 auto;\n\\n  }\n\\n  .aatl-payslip .header {\n\\n    text-align: center;\n\\n    margin-bottom: 8px;\n\\n    border-bottom: 1.5px solid #000;\n\\n    padding-bottom: 5px;\n\\n  }\n\\n  .aatl-payslip .header .company-name {\n\\n    font-size: 19px;\n\\n    font-weight: bold;\n\\n    letter-spacing: 1px;\n\\n    text-transform: uppercase;\n\\n  }\n\\n  .aatl-payslip .header .company-sub {\n\\n    font-size: 10.5px;\n\\n    letter-spacing: 0.5px;\n\\n    margin-top: 1px;\n\\n  }\n\\n  .aatl-payslip .header .doc-title {\n\\n    font-size: 14.5px;\n\\n    font-weight: bold;\n\\n    letter-spacing: 2.5px;\n\\n    margin-top: 6px;\n\\n    text-transform: uppercase;\n\\n  }\n\\n\n\\n  /* Meta info: 4 left / 4 right grid */\n\\n  .aatl-payslip .meta-grid {\n\\n    display: table;\n\\n    width: 100%;\n\\n    table-layout: fixed;\n\\n    margin-bottom: 6px;\n\\n    border-top: 1px dotted #000;\n\\n    border-bottom: 1px dotted #000;\n\\n    padding: 2px 0;\n\\n  }\n\\n  .aatl-payslip .meta-col {\n\\n    display: table-cell;\n\\n    width: 50%;\n\\n    vertical-align: top;\n\\n    padding: 1px 8px;\n\\n  }\n\\n  .aatl-payslip .meta-row {\n\\n    display: table;\n\\n    width: 100%;\n\\n    padding: 2px 0;\n\\n    border-bottom: 1px dotted #000;\n\\n  }\n\\n  .aatl-payslip .meta-row:last-child {\n\\n    border-bottom: none;\n\\n  }\n\\n  .aatl-payslip .meta-label {\n\\n    display: table-cell;\n\\n    font-weight: bold;\n\\n    width: 46%;\n\\n    font-size: 11.5px;\n\\n  }\n\\n  .aatl-payslip .meta-sep {\n\\n    display: table-cell;\n\\n    width: 6%;\n\\n  }\n\\n  .aatl-payslip .meta-value {\n\\n    display: table-cell;\n\\n    width: 48%;\n\\n    font-size: 11.5px;\n\\n  }\n\\n  .aatl-payslip .meta-extra {\n\\n    display: table;\n\\n    width: 100%;\n\\n    margin-top: 2px;\n\\n    padding: 2px 8px;\n\\n    border-bottom: 1px dotted #000;\n\\n    font-size: 11.5px;\n\\n  }\n\\n\n\\n  /* Earnings (left) / Deductions (right) - separate tables, not touching */\n\\n  .aatl-payslip .amount-columns {\n\\n    display: table;\n\\n    width: 100%;\n\\n    table-layout: fixed;\n\\n    border-spacing: 10px 0;\n\\n    margin-top: 8px;\n\\n  }\n\\n  .aatl-payslip .amount-col {\n\\n    display: table-cell;\n\\n    width: 50%;\n\\n    vertical-align: top;\n\\n    border: 1px solid #000;\n\\n  }\n\\n  .aatl-payslip .amount-col table {\n\\n    width: 100%;\n\\n    border-collapse: collapse;\n\\n  }\n\\n  /* No background fill - relies on border only, so it always prints */\n\\n  .aatl-payslip .amount-col th {\n\\n    text-align: left;\n\\n    padding: 5px 6px;\n\\n    font-size: 11px;\n\\n    font-weight: bold;\n\\n    letter-spacing: 0.5px;\n\\n    text-transform: uppercase;\n\\n    border-bottom: 2px solid #000;\n\\n    color: #000;\n\\n  }\n\\n  .aatl-payslip .amount-col th.text-right,\n\\n  .aatl-payslip .amount-col td.text-right {\n\\n    text-align: right;\n\\n  }\n\\n  .aatl-payslip .amount-col td {\n\\n    padding: 3px 6px;\n\\n    border-bottom: 1px dotted #000;\n\\n    font-size: 11.5px;\n\\n    line-height: 1.4;\n\\n    color: #000;\n\\n  }\n\\n  .aatl-payslip .amount-col tr.total-row td {\n\\n    font-weight: bold;\n\\n    border-top: 1px solid #000;\n\\n    border-bottom: none;\n\\n    color: #000;\n\\n  }\n\\n\n\\n  /* Net Pay - no background reliance, bold border + large bold black text */\n\\n  .aatl-payslip .net-row {\n\\n    display: table;\n\\n    width: 100%;\n\\n    border-top: 3px double #000;\n\\n    border-bottom: 3px double #000;\n\\n    color: #000;\n\\n    font-weight: bold;\n\\n    font-size: 14.5px;\n\\n    padding: 7px 8px;\n\\n    margin-top: 8px;\n\\n    box-sizing: border-box;\n\\n  }\n\\n  .aatl-payslip .net-row .net-label {\n\\n    display: table-cell;\n\\n  }\n\\n  .aatl-payslip .net-row .net-value {\n\\n    display: table-cell;\n\\n    text-align: right;\n\\n  }\n\\n\n\\n  .aatl-payslip .bank-strip {\n\\n    width: 100%;\n\\n    margin-top: 6px;\n\\n    padding-top: 4px;\n\\n    border-top: 1px dotted #000;\n\\n    font-size: 11.5px;\n\\n    display: table;\n\\n    color: #000;\n\\n  }\n\\n  .aatl-payslip .bank-strip .cell {\n\\n    display: table-cell;\n\\n    width: 50%;\n\\n  }\n\\n\n\\n  .aatl-payslip .footer {\n\\n    margin-top: 22px;\n\\n    display: table;\n\\n    width: 100%;\n\\n    font-size: 11px;\n\\n  }\n\\n  .aatl-payslip .footer .cell {\n\\n    display: table-cell;\n\\n    width: 50%;\n\\n    text-align: center;\n\\n  }\n\\n  .aatl-payslip .footer .sig-line {\n\\n    margin: 18px 20px 3px 20px;\n\\n    border-bottom: 1px dotted #000;\n\\n  }\n\\n  .aatl-payslip .note {\n\\n    margin-top: 10px;\n\\n    font-size: 9.5px;\n\\n    text-align: center;\n\\n    font-style: italic;\n\\n    color: #000;\n\\n  }\n\\n\n\\n  /* Force any background/color that IS used to actually print */\n\\n  @media print {\n\\n    .aatl-payslip * {\n\\n      -webkit-print-color-adjust: exact !important;\n\\n      print-color-adjust: exact !important;\n\\n      color-adjust: exact !important;\n\\n    }\n\\n  }\n\\n</style>\n\\n\n\\n<div class=\"aatl-payslip\">\n\\n\n\\n  <div class=\"header\">\n\\n    <div class=\"company-name\">{{ doc.company }}</div>\n\\n    <div class=\"company-sub\">\n\\n      {% if frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\n\\n        TIN: {{ frappe.db.get_value(\"Company\", doc.company, \"tax_id\") }}\n\\n      {% endif %}\n\\n    </div>\n\\n    <div class=\"doc-title\">Salary Slip</div>\n\\n  </div>\n\\n\n\\n  <div class=\"meta-grid\">\n\\n    <div class=\"meta-col\">\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">PAYROLL FOR</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ frappe.utils.formatdate(doc.start_date, \"MMMM - yyyy\") }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">SLIP NO</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.name }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">NAME</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.employee_name }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">EMPLOYEE ID</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.employee }}</div>\n\\n      </div>\n\\n    </div>\n\\n    <div class=\"meta-col\">\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">DEPARTMENT</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.department or \"\" }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">BRANCH</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.branch or doc.get(\"cost_center\") or \"\" }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">DESIGNATION</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.designation or \"\" }}</div>\n\\n      </div>\n\\n      <div class=\"meta-row\">\n\\n        <div class=\"meta-label\">PAYMENT DAYS</div>\n\\n        <div class=\"meta-sep\">|</div>\n\\n        <div class=\"meta-value\">{{ doc.payment_days }} / {{ doc.total_working_days }}</div>\n\\n      </div>\n\\n    </div>\n\\n  </div>\n\\n\n\\n  {% if doc.get(\"nssf_no\") %}\n\\n  <div class=\"meta-extra\">\n\\n    <strong>NSSF NO</strong> &nbsp;|&nbsp; {{ doc.nssf_no }}\n\\n  </div>\n\\n  {% endif %}\n\\n\n\\n  <div class=\"amount-columns\">\n\\n    <div class=\"amount-col earnings-col\">\n\\n      <table>\n\\n        <tr>\n\\n          <th style=\"width:60%\">Earnings</th>\n\\n          <th class=\"text-right\" style=\"width:40%\">Amount</th>\n\\n        </tr>\n\\n        {% for row in doc.earnings %}\n\\n        <tr>\n\\n          <td>{{ row.salary_component }}</td>\n\\n          <td class=\"text-right\">{{ \"{:,.2f}\".format(row.amount) }}</td>\n\\n        </tr>\n\\n        {% endfor %}\n\\n        <tr class=\"total-row\">\n\\n          <td>GROSS PAY</td>\n\\n          <td class=\"text-right\">{{ \"{:,.2f}\".format(doc.gross_pay) }}</td>\n\\n        </tr>\n\\n      </table>\n\\n    </div>\n\\n    <div class=\"amount-col deductions-col\">\n\\n      <table>\n\\n        <tr>\n\\n          <th style=\"width:60%\">Deductions</th>\n\\n          <th class=\"text-right\" style=\"width:40%\">Amount</th>\n\\n        </tr>\n\\n        {% for row in doc.deductions %}\n\\n        <tr>\n\\n          <td>{{ row.salary_component }}</td>\n\\n          <td class=\"text-right\">{{ \"{:,.2f}\".format(row.amount) }}</td>\n\\n        </tr>\n\\n        {% endfor %}\n\\n        <tr class=\"total-row\">\n\\n          <td>TOTAL DEDUCT.</td>\n\\n          <td class=\"text-right\">{{ \"{:,.2f}\".format(doc.total_deduction) }}</td>\n\\n        </tr>\n\\n      </table>\n\\n    </div>\n\\n  </div>\n\\n\n\\n  <div class=\"net-row\">\n\\n    <div class=\"net-label\">NET PAY ({{ doc.currency }})</div>\n\\n    <div class=\"net-value\">{{ \"{:,.2f}\".format(doc.net_pay) }}</div>\n\\n  </div>\n\\n\n\\n  {% if doc.bank_name or doc.bank_account_no %}\n\\n  <div class=\"bank-strip\">\n\\n    <div class=\"cell\"><strong>BANK</strong> | {{ doc.bank_name or \"\" }}</div>\n\\n    <div class=\"cell\"><strong>ACC NO</strong> | {{ doc.bank_account_no or \"\" }}</div>\n\\n  </div>\n\\n  {% endif %}\n\\n\n\\n  <div class=\"footer\">\n\\n    <div class=\"cell\">\n\\n      <div class=\"sig-line\"></div>\n\\n      Employee Signature\n\\n    </div>\n\\n    <div class=\"cell\">\n\\n      <div class=\"sig-line\"></div>\n\\n      Authorized Signature\n\\n    </div>\n\\n  </div>\n\\n\n\\n  <div class=\"note\">\n\\n    This is a computer-generated salary slip and does not require a physical stamp.\n\\n  </div>\n\\n\n\\n</div>",
    "disabled": 0,
    "default_print_language": "en",
    "standard": "No"
  }
]